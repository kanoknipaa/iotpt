      "🚗 มีรถ";

    main.innerText =
      "มีรถ";


  }
  else if (status === "available") {

    badge.className =
      "status-badge available";

    badge.innerText =
      "🅿️ ช่องว่าง";

    main.innerText =
      "ช่องว่าง";


  }
  else {

    badge.className =
      "status-badge unknown";

    badge.innerText =
      "⚠️ ไม่ทราบสถานะ";

    main.innerText =
      "ไม่สามารถอ่านค่าได้";

  }


  /* -----------------------------------------------
     Animation
  ------------------------------------------------ */

  if (lastStatus !== null) {

    // ช่องว่าง -> มีรถ
    if (
      lastStatus === "available" &&
      status === "occupied"
    ) {

      carEnterParking();

    }


    // มีรถ -> ช่องว่าง
    else if (
      lastStatus === "occupied" &&
      status === "available"
    ) {

      carExitParking();

    }


    // สถานะเปลี่ยนเป็น Unknown
    else if (
      status === "unknown"
    ) {

      showUnknownSlot();

    }

  }
  else {

    // ครั้งแรกที่เปิด Dashboard

    if (status === "occupied") {

      // ถ้าเปิดมาแล้วมีรถ
      // ให้รถวิ่งเข้าจอดเลย
      carEnterParking();

    }

    else if (status === "available") {

      showEmptySlot();

    }

    else {

      showUnknownSlot();

    }

  }


  /* -----------------------------------------------
     Animation ข้อความสถานะ
  ------------------------------------------------ */

  if (lastStatus !== status) {

    main.classList.remove("changed");

    void main.offsetWidth;

    main.classList.add("changed");

  }


  lastStatus =
    status;

}


