void handleData()
{
  String json = "{";

  json += "\"distance\":";
  
  if (distance < 0)
  {
    json += "null";
  }
  else
  {
    json += String(distance, 2);
  }

  json += ",";

  json += "\"status\":\"";

  if (parkingStatus == "มีรถ")
  {
    json += "occupied";
  }
  else if (parkingStatus == "ช่องว่าง")
  {
    json += "available";
  }
  else
  {
    json += "unknown";
  }

  json += "\",";

  json += "\"occupied\":";
  json += String(occupiedSlots);

  json += ",";

  json += "\"available\":";
  json += String(availableSlots);

  json += ",";

  json += "\"total\":";
  json += String(TOTAL_SLOTS);

  json += "}";

  server.send(
    200,
    "application/json; charset=UTF-8",
    json
  );
}


