// =====================================================
// SETUP
// =====================================================
void setup()
{
  Serial.begin(115200);


  // ===================================================
  // ตั้งค่า GPIO
  // ===================================================

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(LED_BLUE, OUTPUT);
  pinMode(LED_RED, OUTPUT);

  digitalWrite(LED_BLUE, LOW);
  digitalWrite(LED_RED, LOW);


  // ===================================================
  // Wi-Fi AP + STA
  // ===================================================

  WiFi.mode(WIFI_AP_STA);


  // ===================================================
  // เชื่อม Wi-Fi ที่มี Internet
  // ===================================================

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  Serial.print(
    "กำลังเชื่อม Wi-Fi"
  );

  int count = 0;

  while (
    WiFi.status() != WL_CONNECTED &&
    count < 20
  )
  {
    delay(500);

    Serial.print(".");

    count++;
  }

  Serial.println();


  if (WiFi.status() == WL_CONNECTED)
  {
    Serial.println(
      "เชื่อม Wi-Fi สำเร็จ"
    );

    Serial.print(
      "Internet IP: "
    );

    Serial.println(
      WiFi.localIP()
    );
  }
  else
  {
    Serial.println(
      "ไม่สามารถเชื่อม Wi-Fi Internet ได้"
    );
  }


  // ===================================================
  // เปิด Access Point
  // ===================================================

  WiFi.softAP(
    AP_SSID,
    AP_PASSWORD
  );

  Serial.println();

  Serial.println(
    "ESP32 Access Point เปิดแล้ว"
  );

  Serial.print(
    "AP SSID: "
  );

  Serial.println(
    AP_SSID
  );

  Serial.print(
    "AP IP: "
  );

  Serial.println(
    WiFi.softAPIP()
  );


  // ===================================================
  // Web Server
  // ===================================================

  server.on(
    "/",
    handleRoot
  );

  // API สำหรับ Dashboard
  server.on(
    "/data",
    handleData
  );

  server.begin();

  Serial.println(
    "Web Server Started"
  );

  Serial.println(
    "================================"
  );
}


// =====================================================
// LOOP
// =====================================================
void loop()
{
  // ===================================================
  // รับ Request จาก Browser
  // ===================================================

  server.handleClient();


  // ===================================================
  // อ่านระยะ
  // ===================================================

  float d = readDistance();


  // ===================================================
  // ตรวจสอบสถานะ
  // ===================================================

  if (d < 0)
  {
    parkingStatus = "ไม่ทราบสถานะ";

    occupiedSlots = 0;

    availableSlots =
      TOTAL_SLOTS;

    digitalWrite(
      LED_RED,
      LOW
    );

    digitalWrite(
      LED_BLUE,
      LOW
    );
  }

  else if (d <= CAR_DISTANCE)
  {
    parkingStatus = "มีรถ";

    occupiedSlots = 1;

    availableSlots =
      TOTAL_SLOTS - occupiedSlots;

    digitalWrite(
      LED_RED,
      HIGH
    );

    digitalWrite(
      LED_BLUE,
      LOW
    );
  }

  else
  {
    parkingStatus = "ช่องว่าง";

    occupiedSlots = 0;

    availableSlots =
      TOTAL_SLOTS;

    digitalWrite(
      LED_RED,
      LOW
    );

    digitalWrite(
      LED_BLUE,
      HIGH
    );
  }


  // ===================================================
  // Serial Monitor
  // ===================================================

  Serial.print(
    "Distance: "
  );


  if (d < 0)
  {
    Serial.println(
      "No Echo"
    );
  }

  else
  {
    Serial.print(
      d
    );

    Serial.print(
      " cm"
    );

    Serial.print(
      " | สถานะ: "
    );

    Serial.println(
      parkingStatus
    );
  }


  // ===================================================
  // ส่ง Google Sheets ทุก 10 วินาที
  // ===================================================

  if (
    millis() - lastSendTime >= 10000
  )
  {
    lastSendTime =
      millis();

    sendToGoogleSheets(
      d,
      parkingStatus
    );
  }


  // ===================================================
  // หน่วงเวลา
  // ===================================================

  delay(500);
}
